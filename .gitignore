# This repository tracks the Gymcast Marketing Tools plugin, not WordPress core.
/*

# Repository configuration and project documentation.
!/.gitignore
!/docs/
/docs/*
!/docs/gymcast-marketing-plugin-brief.md

# Track only the Gymcast plugin within wp-content.
!/wp-content/
/wp-content/*
!/wp-content/plugins/
/wp-content/plugins/*
!/wp-content/plugins/gymcast-marketing-tools/
!/wp-content/plugins/gymcast-marketing-tools/**
